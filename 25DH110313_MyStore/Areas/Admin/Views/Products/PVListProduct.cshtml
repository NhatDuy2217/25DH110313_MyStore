@model _25DH110313_MyStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc

<head>
    <style>
        img {
            height: 200px;
            width: 150px;
        }
    </style>
</head>

@if (Model.Products != null && Model.Products.Any())
{
    <h2 class="alert alert-success">DANH SÁCH SẢN PHẨM</h2>

    <table class="table bg-info col-lg-12 col-md-6 col-sm-3 container-fluid">
        <thead>
            <tr>
                <th class="bg-success col-md-2">Tên sản phẩm</th>
                <th class="bg-success col-md-2">Hình ảnh</th>
                <th class="bg-success col-md-2">Đơn giá</th>
                <th class="bg-success col-md-2">Danh mục</th>
                <th class="bg-success col-md-4"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td><img src="@Html.DisplayFor(modelItem => item.ProductImage)" /></td>
                    <td>@Html.DisplayFor(modelItem => item.ProductPrice)</td>
                    <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>

                    <td>
                        @Html.ActionLink("Cập nhật", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-success btn-sm" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }),
        new PagedList.Mvc.PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            UlElementClasses = new[] { "pagination" }
        }
        )
    </div>
}
else
{
    <p>Không có sản phẩm nào được tìm thấy.</p>
}

<div class="form-group">
    <div class="col-md-8 col-md-4">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
    </div>
</div>
