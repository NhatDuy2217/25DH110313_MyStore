@model _25DH110313_MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="alert alert-success">XÓA DANH MỤC</h2>

@using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
<div class="form-horizontal">
    <hr />
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <h4 class="alert alert-danger">Bạn có chắc chắn muốn xóa danh mục này?</h4>
        </div>
    </div>
    <div class="form-group">
        <div class="control-label col-md-2">
            <dt>
                Tên danh mục :
            </dt>
        </div>
        <div class="col-md-10">
            @* Hiển thị giá trị  của CategoryName *@
            @Html.DisplayFor(model => model.CategoryName)
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xóa" class="btn btn-danger" /> |
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
            </div>
        </div>
    </div>
</div>

        }
